ADMIN_USERNAME=admin
# Preferred: sha256:<hex>. Plain ADMIN_PASSWORD is still supported for local setup.
ADMIN_PASSWORD_HASH=sha256:replace-with-sha256-password-hash
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# GitHub-backed CMS storage. Required for production admin saves.
GITHUB_TOKEN=replace-with-a-fine-grained-github-token
GITHUB_OWNER=TheApostle-07
GITHUB_REPO=CraftingCorner
GITHUB_BRANCH=main
GITHUB_CONTENT_PATH=src/data

# Optional legacy public hold-page toggle storage.
# Leave unset for no database. Set to "database" only if you intentionally
# want the old Active/Not Active toggle to use PostgreSQL.
SITE_STATUS_STORAGE=github
SITE_STATUS_GITHUB_TOKEN=replace-with-a-github-token
SITE_STATUS_REPO_OWNER=TheApostle-07
SITE_STATUS_REPO_NAME=CraftingCorner
SITE_STATUS_REPO_BRANCH=main
SITE_STATUS_FILE_PATH=site-status.json
