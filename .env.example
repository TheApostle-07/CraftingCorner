ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Preferred persistent storage on hosted deployments.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional fallback if you do not want to use a database. If
# SITE_STATUS_GITHUB_TOKEN is present, GitHub-backed storage is used.
SITE_STATUS_STORAGE=github
SITE_STATUS_GITHUB_TOKEN=replace-with-a-github-token
SITE_STATUS_REPO_OWNER=TheApostle-07
SITE_STATUS_REPO_NAME=CraftingCorner
SITE_STATUS_REPO_BRANCH=main
SITE_STATUS_FILE_PATH=site-status.json
